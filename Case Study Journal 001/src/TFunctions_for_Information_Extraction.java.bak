	public ArrayList<TStimulus> Manage_Positions_Acquired( TPerception Perception,
			HashMap<String, TBelief> Map_Uninhibited_Beliefs,
    		HashMap<String, TRegion> Map_Uninhibited_Regions )
	{
		ArrayList<TStimulus> Stimuli = new ArrayList<TStimulus>();
		TStimulus Stimulus = (TStimulus) Map_Uninhibited_Beliefs.get( "ST_Stimulus_Danger_on_the_Route" );
		
		return Stimuli;
	}
	
	public ArrayList<TStimulus> Manage_Stimulus_Danger_on_the_Route( TPerception Perception, 
			HashMap<String, TBelief> Map_Uninhibited_Beliefs,
    		HashMap<String, TRegion> Map_Uninhibited_Regions )
	{
		ArrayList<TStimulus> Stimuli = new ArrayList<TStimulus>();

		HashSet<String> Types_to_Consider = new HashSet<String>();
